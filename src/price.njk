---
layout: base.njk
permalink: /price/
title: Massage Pricing
description: Full pricing for massage therapy and facial treatments at Signature Therapeutic Wellness in Redmond, WA.
---
<div class="service-hero">
  <div class="service-hero-img">
    <img src="/images/about-trust.jpg" alt="Massage therapist providing a back treatment" loading="eager" fetchpriority="high">
  </div>
  <div class="service-hero-content">
    <span class="tag" style="color:#7DB4F5;">Full Menu</span>
    <h1>Services &amp; Pricing</h1>
    <p>Transparent pricing, personalized care. Every session tailored to your body's needs.</p>
  </div>
</div>

<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <span>&rsaquo;</span> <span>Price</span></nav>

<div class="container">
  <div class="page-layout">
    <div class="page-layout-content" style="padding-top: 3rem;">
      {% set groups = [
        { name: "PIP/L&I Injury Massage", rows: [ { label: "60 Min", price: "$160" } ] },
        { name: "Swedish Massage", rows: [ { label: "60 Min", price: "$95" }, { label: "90 Min", price: "$135" }, { label: "120 Min", price: "$165" } ] },
        { name: "Deep Tissue Massage", rows: [ { label: "60 Min", price: "$105" }, { label: "90 Min", price: "$155" }, { label: "120 Min", price: "$205" } ] },
        { name: "Lymphatic Detox Massage", rows: [ { label: "90 Min", price: "$155" } ] },
        { name: "Lomi Lomi Massage", rows: [ { label: "60 Min", price: "$125" }, { label: "90 Min", price: "$175" } ] },
        { name: "Pain Relief Massage", rows: [ { label: "60 Min · Cupping + Pain Relief Cream", price: "$145" }, { label: "90 Min · Cupping + Pain Relief Cream", price: "$185" } ] },
        { name: "Facial Services", rows: [ { label: "50 Min Urban Facial", price: "$95" }, { label: "70 Min Deep Cleaning Facial", price: "$135" }, { label: "70 Min Hydrating Facial", price: "$135" }, { label: "90 Min Luxury Facial", price: "$165" } ] }
      ] %}
      {% for group in groups %}
      <p class="pricing-section-title">{{ group.name }}</p>
      <div class="pricing-table">
        <div class="pricing-table-head"><span>Duration</span><span>Price</span></div>
        {% for row in group.rows %}
        <div class="pricing-table-row"><span class="name">{{ row.label }}</span><span class="amount">{{ row.price }}</span></div>
        {% endfor %}
      </div>
      {% endfor %}

      <p class="pricing-section-title">Add-Ons</p>
      <div class="pricing-table">
        <div class="pricing-table-head"><span>Add-On</span><span>Price</span></div>
        <div class="pricing-table-row"><span class="name">Hot Stone Treatment</span><span class="amount">Included</span></div>
        <div class="pricing-table-row"><span class="name">Pain Relief Oil</span><span class="amount">$20</span></div>
        <div class="pricing-table-row"><span class="name">CBD</span><span class="amount">$30</span></div>
        <div class="pricing-table-row"><span class="name">Cupping</span><span class="amount">$20</span></div>
      </div>
    </div>

    <div class="page-layout-sidebar" style="padding-top: 3rem;">
      <div class="sidebar-book">
        <h3>Ready to Book?</h3>
        <p>Reserve your session online in minutes, or call to schedule.</p>
        <a href="{{ site.bookUrl }}" class="btn" target="_blank" rel="noopener">Book Online Now</a>
        <a href="{{ site.phoneHref }}" class="btn-ghost">Call {{ site.phone }}</a>
      </div>
      <div class="insurance-tip">
        <div class="tip-label">Insurance Accepted</div>
        <p>We bill in-network plans directly and provide a Superbill for out-of-network coverage.</p>
        <a href="/insurance-accepted-massage/">Check your coverage &rsaquo;</a>
      </div>
      <div class="sidebar-card">
        <h4>Gift Cards</h4>
        <p style="font-size:.8rem;color:#5B6472;margin-bottom:1rem;">Give the gift of relaxation and recovery.</p>
        <a href="{{ site.giftCardUrl }}" class="btn-outline" target="_blank" rel="noopener" style="display:block;text-align:center;padding:.75rem;">Buy a Gift Card</a>
      </div>
    </div>
  </div>
</div>

<div class="cta-strip" style="background: #EDF2FA;">
  <div class="container" style="text-align:center;">
    <span class="tag">Ready to Book?</span>
    <h2>Reserve Your Session Today</h2>
    <p>Sessions available by appointment. Easy online booking or call us directly.</p>
    <div class="btn-row" style="justify-content:center;">
      <a href="{{ site.bookUrl }}" class="btn" target="_blank" rel="noopener">Book Now</a>
      <a href="{{ site.phoneHref }}" class="btn-outline">Call {{ site.phone }}</a>
    </div>
  </div>
</div>
