---
layout: base.njk
---
<div class="service-hero">
  <div class="service-hero-img">
    <img src="/images/{{ heroImage }}" alt="{{ heroAlt }}" loading="eager" fetchpriority="high">
  </div>
  <div class="service-hero-content">
    <span class="tag" style="color:#7DB4F5;">{{ eyebrow }}</span>
    <h1>{{ title }}</h1>
    <p>{{ intro }}</p>
  </div>
</div>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a> <span>&rsaquo;</span>
  {% if crumbParent %}<a href="{{ crumbParent.href }}">{{ crumbParent.label }}</a> <span>&rsaquo;</span>{% endif %}
  <span>{{ crumbLabel or title }}</span>
</nav>

<div class="container">
  <div class="page-layout">
    <div class="page-layout-content">
      {% if introQuote %}<p class="intro-quote">&ldquo;{{ introQuote }}&rdquo;</p>{% endif %}

      {% if benefits %}
      <h2 class="page-section-title">Benefits</h2>
      <div class="benefits-grid">
        {% for b in benefits %}
        <div class="benefit-item">
          <div class="benefit-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div>
            <div class="benefit-title">{{ b.title }}</div>
            <div class="benefit-desc">{{ b.body }}</div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if content %}
      <div class="mt-10">{{ content | safe }}</div>
      {% endif %}
    </div>

    <div class="page-layout-sidebar">
      <div class="sidebar-book">
        <h3>Reserve Your Session</h3>
        <p>Online booking available anytime, or call us directly to schedule.</p>
        <a href="{{ site.bookUrl }}" class="btn" target="_blank" rel="noopener">Book Online</a>
        <a href="{{ site.phoneHref }}" class="btn-ghost">Call {{ site.phone }}</a>
        <p class="sidebar-book-note">Or email <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>

      {% if priceRows %}
      <div class="sidebar-card">
        <h4>{{ title }} Pricing</h4>
        {% for row in priceRows %}
        <div class="pricing-row"><span class="label">{{ row.label }}</span><span class="price">{{ row.price }}</span></div>
        {% endfor %}
      </div>
      {% endif %}

      <div class="insurance-tip">
        <div class="tip-label">Insurance</div>
        <p>We bill in-network plans directly and provide a Superbill for out-of-network coverage.</p>
        <a href="/insurance-accepted-massage/">Check your coverage &rarr;</a>
      </div>

      {% if relatedLinks %}
      <div class="sidebar-card">
        <h4>Related Services</h4>
        <div class="related-list">
          {% for r in relatedLinks %}
          <a href="{{ r.href }}">{{ r.label }}</a>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="cta-strip" style="background: #EDF2FA;">
  <div class="container" style="text-align:center;">
    <span class="tag">Ready to Feel Better?</span>
    <h2>{{ ctaTitle or "Book Your " + title + " Today" }}</h2>
    <p>Sessions available by appointment. Easy online booking or call us directly.</p>
    <div class="btn-row" style="justify-content:center;">
      <a href="{{ site.bookUrl }}" class="btn" target="_blank" rel="noopener">Book Online</a>
      <a href="{{ site.phoneHref }}" class="btn-outline">Call {{ site.phone }}</a>
    </div>
  </div>
</div>
