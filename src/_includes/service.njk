---
layout: base.njk
---
<section class="relative overflow-hidden pt-40 pb-24 sm:pt-48 sm:pb-32">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 px-6 lg:grid-cols-12">
    <div class="reveal lg:col-span-6">
      <p class="eyebrow">{{ eyebrow }}</p>
      <h1 class="mt-5 text-4xl leading-[1.08] sm:text-5xl">{{ title }}</h1>
      <p class="mt-6 max-w-md text-[1.05rem] leading-relaxed text-espresso-500">{{ intro }}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="{{ site.bookUrl }}" target="_blank" rel="noopener" class="group btn-primary">
          Book This Treatment
          <span class="btn-icon"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a href="tel:{{ site.phoneHref | replace('tel:', '') }}" class="group btn-outline">
          Call {{ site.phone }}
        </a>
      </div>
    </div>

    <div class="reveal lg:col-span-6">
      <div class="shell rotate-1">
        <div class="shell-core overflow-hidden">
          <img src="/images/{{ heroImage }}" alt="{{ heroAlt }}" class="h-[420px] w-full object-cover sm:h-[500px]" loading="eager">
        </div>
      </div>
    </div>
  </div>
</section>

{% if benefits %}
<section class="px-6 pb-28">
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {% for b in benefits %}
      <div class="reveal shell" style="transition-delay: {{ loop.index0 * 90 }}ms">
        <div class="shell-core p-7">
          <span class="font-serif text-sm text-gold-500">0{{ loop.index }}</span>
          <h3 class="mt-3 text-lg leading-snug">{{ b.title }}</h3>
          <p class="mt-3 text-sm leading-relaxed text-espresso-500">{{ b.body }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if content %}
<section class="px-6 pb-28">
  <div class="mx-auto max-w-4xl reveal">
    {{ content | safe }}
  </div>
</section>
{% endif %}

{% if priceRows %}
<section class="px-6 pb-28">
  <div class="mx-auto max-w-3xl reveal">
    <div class="shell">
      <div class="shell-core p-8 sm:p-10">
        <p class="eyebrow">Pricing</p>
        <div class="mt-6 divide-y divide-espresso-600/10">
          {% for row in priceRows %}
          <div class="flex items-center justify-between py-4">
            <span class="text-espresso-600">{{ row.label }}</span>
            <span class="font-serif text-lg text-espresso-700">{{ row.price }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="px-6 pb-28">
  <div class="mx-auto max-w-6xl reveal">
    <div class="rounded-[2.5rem] bg-espresso-600 px-8 py-14 text-center sm:px-16 sm:py-16">
      <h2 class="text-cream-50 text-3xl sm:text-4xl">Ready to feel better?</h2>
      <p class="mx-auto mt-4 max-w-xl text-cream-100/70">Book online in under a minute, or call us and we'll take care of the rest.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="{{ site.bookUrl }}" target="_blank" rel="noopener" class="group btn-primary bg-gold-500 hover:bg-gold-600 text-espresso-700">
          Book Now
          <span class="btn-icon bg-espresso-700/10"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a href="/price/" class="rounded-full px-6 py-2.5 text-cream-50 ring-1 ring-cream-50/25 transition-all duration-500 ease-fluid hover:ring-cream-50/50">See Full Price List</a>
      </div>
    </div>
  </div>
</section>
