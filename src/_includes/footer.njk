<footer class="footer">
  <div class="footer-main container">
    <div class="footer-brand">
      <div class="footer-logo">
        {% include "logo.njk" %}
        <span>Signature Therapeutic Wellness</span>
      </div>
      <p>Personalized, patient-centered massage therapy in Redmond, WA — dedicated to relaxation, pain relief, and improved mobility.</p>
    </div>
    <div class="footer-col">
      <h4>Our Services</h4>
      <a href="/swedish-massage/">Swedish Massage</a>
      <a href="/deep-tissue-massage/">Deep Tissue Massage</a>
      <a href="/pain-relief-massage/">Pain Relief Massage</a>
      <a href="/lymphatic-detox-massage/">Lymphatic Detox Massage</a>
      <a href="/facial-skincare/">Facial &amp; Skin Care</a>
      <a href="/pip-li-injury-massage/">PIP/L&amp;I Injury Massage</a>
      <a href="/insurance-coveredmassage/">Insurance-Covered Massage</a>
    </div>
    <div class="footer-col">
      <h4>Conditions &amp; More</h4>
      <a href="/neck-shoulder-pain/">Neck &amp; Shoulder Pain</a>
      <a href="/lower-back-pain/">Back &amp; Lower Back Pain</a>
      <a href="/hips-legs-pain/">Hips &amp; Legs Pain</a>
      <a href="/manual-lymphatic-drainage/">Manual Lymphatic Drainage</a>
      <a href="/insurance-accepted-massage/">Insurance Accepted</a>
      <a href="/price/">Price</a>
    </div>
    <div class="footer-col">
      <h4>Visit Us</h4>
      <address class="footer-address">
        <p>
          <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {{ site.address.line1 }}<br>{{ site.address.line2 }}
        </p>
        <a href="{{ site.phoneHref }}">
          <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.01 1.18 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91A16 16 0 0016.09 17.91l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          {{ site.phone }}
        </a>
        <a href="mailto:{{ site.email }}">
          <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          {{ site.email }}
        </a>
      </address>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {{ "now" | currentYear }} Signature Therapeutic Wellness. All rights reserved.</p>
    <div class="flex gap-6">
      {% for link in site.footerLinks %}
      <a href="{{ link.href }}" class="!mb-0 hover:text-blue-300 transition-colors">{{ link.label }}</a>
      {% endfor %}
    </div>
  </div>
</footer>
