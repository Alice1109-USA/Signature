<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.shortName }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }} | {{ site.shortName }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/images/home-hero.jpg">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="stylesheet" href="/css/style.css">

  {% if schema %}
  <script type="application/ld+json">{{ schema | dump | safe }}</script>
  {% endif %}
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-navy-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-full">Skip to content</a>

  {% include "nav.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  <script src="/js/main.js" defer></script>
</body>
</html>
